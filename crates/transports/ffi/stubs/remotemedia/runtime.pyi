from typing import Any, Awaitable, Optional
import numpy as np
import numpy.typing as npt

__version__: str

def execute_pipeline(manifest) -> Any: ...
def execute_pipeline_with_input(*args, **kwargs): ...
def execute_pipeline_with_instances(*args, **kwargs): ...
def get_runtime_version(*args, **kwargs): ...
def is_available(*args, **kwargs): ...

# Immutable exported buffers and Python bytes can retain their owners. Private
# mutable arrays require an explicit compatibility copy or strict rejection.

class MappedSizeClass:
    """Immutable slot size (bytes) and count."""
    @property
    def bytes(self) -> int: ...
    @property
    def slots(self) -> int: ...
    def __init__(self, bytes: int, slots: int) -> None: ...

class MappedPoolConfig:
    """Per-session pool; requires mapped-buffers on Windows/Linux."""
    @property
    def classes(self) -> list[MappedSizeClass]: ...
    @property
    def max_bytes(self) -> int: ...
    @property
    def max_leases(self) -> int: ...
    def __init__(self, classes: list[MappedSizeClass], max_bytes: int, max_leases: int) -> None: ...

class PipelineBufferConfig:
    """Immutable unified core policy with explicit node-retention budgets."""
    @property
    def policy(self) -> str: ...
    @property
    def node_retention_owners(self) -> int: ...
    @property
    def node_retention_bytes(self) -> int: ...
    @property
    def mapped_pool(self) -> Optional[MappedPoolConfig]: ...
    def __init__(self, policy: str, node_retention_owners: int, node_retention_bytes: int, *, mapped_pool: Optional[MappedPoolConfig] = None) -> None: ...

class PyStreamingSession:
    @property
    def session_id(self) -> str: ...
    def output_allocator(self) -> Any: ...
    def input_copy_report(self) -> dict[str, Any]: ...
    async def send_input(self, data: Any, *, require_zero_copy: bool = False) -> None: ...
    async def recv_audio(self) -> Any: ...
    async def recv_video(self) -> Any: ...
    async def recv_data(self) -> Any: ...
    async def recv_output(self) -> Any: ...
    async def signal_input_complete(self) -> None: ...
    async def close(self) -> None: ...

def create_streaming_session(manifest_json: str, *, pipeline_buffers: Optional[PipelineBufferConfig] = None) -> Awaitable[PyStreamingSession]: ...
def create_shared_streaming_session(manifest_json: str, shared_session_key: str, participant_id: str, participant_role: str, track_id: Optional[str] = None, modality: Optional[str] = None, display_name: Optional[str] = None, *, pipeline_buffers: Optional[PipelineBufferConfig] = None) -> Awaitable[PyStreamingSession]: ...
