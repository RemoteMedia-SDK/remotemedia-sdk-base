{
  "version": "1",
  "metadata": {
    "name": "transcribe-mobile",
    "description": "Speech-to-text only with VAD",
    "auto_negotiate": true,
    "strict_capabilities": false
  },
  "plugins": [
    {
      "path": "/data/data/com.remotemedia.inprocess/files/libsilero_vad_loadable_plugin.so"
    },
    {
      "path": "/data/data/com.remotemedia.inprocess/files/libwhisper_loadable_plugin.so"
    }
  ],
  "nodes": [
    {
      "id": "vad_chunker",
      "node_type": "AudioChunkerNode",
      "params": {
        "chunk_size": 512
      },
      "is_streaming": true
    },
    {
      "id": "vad",
      "node_type": "SileroVADNode",
      "params": {
        "model_path": "/data/data/com.remotemedia.inprocess/files/models/silero-vad/silero_vad.onnx",
        "threshold": 0.5,
        "neg_threshold": 0.35,
        "sampling_rate": 16000,
        "min_speech_duration_ms": 250,
        "min_silence_duration_ms": 500,
        "speech_pad_ms": 150,
        "execution_mode": "InProcess"
      },
      "is_streaming": true
    },
    {
      "id": "accumulator",
      "node_type": "AudioBufferAccumulatorNode",
      "params": {
        "min_utterance_duration_ms": 300,
        "max_utterance_duration_ms": 30000,
        "emit_cancel_on_speech_start": false
      },
      "is_streaming": true
    },
    {
      "id": "stt",
      "node_type": "WhisperNode",
      "params": {
        "model": "tiny",
        "backend": "litert",
        "model_path": "/data/data/com.remotemedia.inprocess/files/models/whisper/whisper_tiny_30s_f32.tflite",
        "tokenizer_path": "/data/data/com.remotemedia.inprocess/files/models/whisper/tokenizer.json",
        "config_path": "/data/data/com.remotemedia.inprocess/files/models/whisper/config.json",
        "language": "en",
        "task": "transcribe",
        "max_tokens": 224,
        "max_window_ms": 2000,
        "execution_mode": "InProcess"
      },
      "is_streaming": true
    },
    {
      "id": "text_output",
      "node_type": "DataSinkNode",
      "params": {},
      "is_streaming": true
    }
  ],
  "connections": [
    {
      "from": "vad_chunker",
      "to": "vad"
    },
    {
      "from": "vad",
      "to": "accumulator"
    },
    {
      "from": "accumulator",
      "to": "stt"
    },
    {
      "from": "stt",
      "to": "text_output"
    }
  ]
}
