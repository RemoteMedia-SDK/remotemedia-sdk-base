{
  "version": "1",
  "metadata": {
    "name": "voice-assistant-mobile",
    "description": "Offline voice assistant with VAD, STT, LLM (Gemma via LiteRT), and TTS",
    "auto_negotiate": true,
    "strict_capabilities": false
  },
  "plugins": [
    {
      "path": "/data/data/com.remotemedia.inprocess/files/libwhisper_loadable_plugin.so"
    },
    {
      "path": "/data/data/com.remotemedia.inprocess/files/liblitert_lm_loadable_plugin.so"
    },
    {
      "path": "/data/data/com.remotemedia.inprocess/files/libmisaki_g2p_plugin.so"
    },
    {
      "path": "/data/data/com.remotemedia.inprocess/files/libkokoro_onnx_plugin.so"
    }
  ],
  "nodes": [
    {
      "id": "vad",
      "node_type": "VADNode",
      "params": {
        "frame_duration_ms": 30,
        "energy_threshold": 0.02,
        "execution_mode": "InProcess"
      },
      "is_streaming": true
    },
    {
      "id": "stt",
      "node_type": "WhisperNode",
      "params": {
        "model": "tiny",
        "backend": "litert",
        "model_path": "/data/data/com.remotemedia.inprocess/files/models/whisper/whisper_tiny_30s_f32.tflite",
        "tokenizer_path": "/data/data/com.remotemedia.inprocess/files/models/whisper/tokenizer.json",
        "config_path": "/data/data/com.remotemedia.inprocess/files/models/whisper/config.json",
        "language": "en",
        "task": "transcribe",
        "max_tokens": 224,
        "max_window_ms": 2000,
        "execution_mode": "InProcess"
      },
      "is_streaming": true
    },
    {
      "id": "llm",
      "node_type": "LiteRtLmGenerationNode",
      "params": {
        "model_path": "/data/data/com.remotemedia.inprocess/files/models/gemma-4-E2B-it.litertlm",
        "backend": "cpu",
        "cache_dir": "/data/data/com.remotemedia.inprocess/files/cache/litert-lm",
        "max_num_tokens": 2048,
        "parallel_file_section_loading": true,
        "execution_mode": "InProcess"
      },
      "is_streaming": true
    },
    {
      "id": "text_collector",
      "node_type": "TextCollectorNode",
      "params": {
        "split_pattern": "\\s+",
        "min_sentence_length": 1,
        "yield_partial_on_end": true
      },
      "is_streaming": true
    },
    {
      "id": "g2p",
      "node_type": "MisakiG2PNode",
      "params": {
        "resource_dir": "/data/data/com.remotemedia.inprocess/files/models/misaki-g2p",
        "dialect": "en-US",
        "unknown_policy": "grapheme",
        "emit_token_metadata": false,
        "execution_mode": "InProcess"
      },
      "is_streaming": true
    },
    {
      "id": "tts",
      "node_type": "KokoroTTSNode",
      "params": {
        "backend": "onnx",
        "model_dir": "/data/data/com.remotemedia.inprocess/files/models/kokoro",
        "model": "model_fp16.onnx",
        "tokenizer_path": "/data/data/com.remotemedia.inprocess/files/models/kokoro/tokenizer.json",
        "voice": "af_bella",
        "speed": 1.0,
        "input_mode": "phonemes",
        "execution_provider": "cpu",
        "nnapi_use_fp16": false,
        "nnapi_disable_cpu": false,
        "intra_threads": 4,
        "inter_threads": 1
      },
      "is_streaming": true
    },
    {
      "id": "audio_output",
      "node_type": "DataSinkNode",
      "params": {},
      "is_streaming": true
    }
  ],
  "connections": [
    {
      "from": "vad",
      "to": "stt"
    },
    {
      "from": "stt",
      "to": "llm"
    },
    {
      "from": "llm",
      "to": "text_collector"
    },
    {
      "from": "text_collector",
      "to": "g2p"
    },
    {
      "from": "g2p",
      "to": "tts"
    },
    {
      "from": "tts",
      "to": "audio_output"
    }
  ]
}
