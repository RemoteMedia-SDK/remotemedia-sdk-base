<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".HermesProfileActivity">

    <!-- Toolbar handled by ActionBar -->

    <!-- Profile Status -->
    <TextView
        android:id="@+id/profileStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hermes_profile_status_not_loaded"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Hermes Home Section -->
    <TextView
        android:id="@+id/hermesHomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/hermes_home_label"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/profileStatusLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/hermesHomePath"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
        android:textIsSelectable="true"
        android:background="@color/surface"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/hermesHomeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/copyHomeBtn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyHomeBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/copy_path"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:layout_constraintTop_toBottomOf="@id/hermesHomeTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/hermesHomePath" />

    <!-- Profile Name Section -->
    <TextView
        android:id="@+id/profileNameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hermes_profile_name_label"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/hermesHomePath"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/profileNameValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
        android:textIsSelectable="true"
        android:background="@color/surface"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/profileNameTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/copyProfileBtn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyProfileBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/copy_path"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:layout_constraintTop_toBottomOf="@id/profileNameTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/profileNameValue" />

    <!-- Config Path Section -->
    <TextView
        android:id="@+id/configPathTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hermes_config_label"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/profileNameValue"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/configPathValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
        android:textIsSelectable="true"
        android:background="@color/surface"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/configPathTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/configStatusIcon" />

    <ImageView
        android:id="@+id/configStatusIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/hermes_config_missing"
        app:layout_constraintTop_toBottomOf="@id/configPathTitle"
        app:layout_constraintEnd_toStartOf="@id/copyConfigBtn"
        app:layout_constraintBottom_toBottomOf="@id/configPathValue"
        tools:src="@android:drawable/presence_offline" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyConfigBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/copy_path"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:layout_constraintTop_toBottomOf="@id/configPathTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/configPathValue" />

    <!-- SOUL.md Path Section -->
    <TextView
        android:id="@+id/soulPathTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/hermes_soul_label"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/configPathValue"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/soulPathValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
        android:textIsSelectable="true"
        android:background="@color/surface"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/soulPathTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/soulStatusIcon" />

    <ImageView
        android:id="@+id/soulStatusIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/hermes_soul_missing"
        app:layout_constraintTop_toBottomOf="@id/soulPathTitle"
        app:layout_constraintEnd_toStartOf="@id/copySoulBtn"
        app:layout_constraintBottom_toBottomOf="@id/soulPathValue"
        tools:src="@android:drawable/presence_offline" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copySoulBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/copy_path"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:layout_constraintTop_toBottomOf="@id/soulPathTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/soulPathValue" />

    <!-- Config Content Section -->
    <TextView
        android:id="@+id/configContentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="config.yaml Content"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/soulPathValue"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/configContentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/surface"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/configContentTitle"
        app:layout_constraintBottom_toTopOf="@id/soulContentTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/configContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
            android:textColor="@color/primary_text"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            tools:text="model:\n  base_url: http://localhost:30000/v1\n  default: hermes-3-llama-3.1-8b\n  temperature: 0.7\n  max_tokens: 2048" />
    </ScrollView>

    <!-- SOUL.md Content Section -->
    <TextView
        android:id="@+id/soulContentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="SOUL.md Content"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/configContentScroll"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/soulContentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/surface"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/soulContentTitle"
        app:layout_constraintBottom_toTopOf="@id/modelConfigTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/soulContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
            android:textColor="@color/primary_text"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            tools:text="# Agent Soul\n\nYou are a helpful assistant..." />
    </ScrollView>

    <!-- Model Configuration Section -->
    <TextView
        android:id="@+id/modelConfigTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/hermes_model_config"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/soulContentScroll"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/modelConfigContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/debug_panel"
        app:layout_constraintTop_toBottomOf="@id/modelConfigTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hermes_base_url"
                android:textAppearance="@style/TextAppearance.RemoteMedia.Label" />

            <TextView
                android:id="@+id/baseUrlValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
                android:textColor="@color/secondary_text"
                tools:text="https://inference-api.nousresearch.com/v1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hermes_model"
                android:textAppearance="@style/TextAppearance.RemoteMedia.Label" />

            <TextView
                android:id="@+id/modelValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
                android:textColor="@color/secondary_text"
                tools:text="nvidia/nemotron-3-ultra:free" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Provider"
                android:textAppearance="@style/TextAppearance.RemoteMedia.Label" />

            <TextView
                android:id="@+id/providerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
                android:textColor="@color/secondary_text"
                tools:text="nous" />
        </LinearLayout>

    </LinearLayout>

    <!-- Refresh Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/refreshBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/refresh"
        app:layout_constraintTop_toBottomOf="@id/modelConfigContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>