<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Toolbar handled by ActionBar -->

    <!-- Pipeline Selector -->
    <TextView
        android:id="@+id/pipelineLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pipeline:"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/pipelineSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/pipelineLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Initializing..."
        android:textAppearance="@style/TextAppearance.RemoteMedia.Status"
        app:layout_constraintTop_toBottomOf="@id/pipelineSpinner"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pipelineSpinner"
        app:layout_constraintStart_toEndOf="@id/statusText"
        app:layout_constraintBottom_toBottomOf="@id/statusText" />

    <!-- Mic Button (Large) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/micButton"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:enabled="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:icon="@android:drawable/ic_media_play"
        app:iconSize="64dp"
        app:iconGravity="textTop"
        android:iconTint="@color/white"
        android:text="@string/btn_start_listening"
        android:textSize="14sp"
        app:cornerRadius="60dp"
        app:backgroundTint="@color/mic_active"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Control Buttons Row -->
    <LinearLayout
        android:id="@+id/controlButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/micButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/btn_stop"
            android:icon="@android:drawable/ic_media_pause"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_test_python"
            android:icon="@android:drawable/ic_menu_manage"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>

    <!-- Transcript Area -->
    <TextView
        android:id="@+id/transcriptLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/label_transcript"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/controlButtons"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/transcriptScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/surface"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/transcriptLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/transcriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
            android:textColor="@color/primary_text"
            android:textIsSelectable="true"
            tools:text="Voice assistant transcript will appear here..." />
    </ScrollView>

    <!-- Streaming tokens display (bottom) -->
    <TextView
        android:id="@+id/streamingText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Streaming"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/transcriptScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Streaming: token1 token2 token3..." />

</androidx.constraintlayout.widget.ConstraintLayout>
