<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MicrodroidRunnerManagementActivity">

    <!-- Toolbar handled by ActionBar -->

    <!-- AVF Support Status -->
    <TextView
        android:id="@+id/avfSupportTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/avf_support_label"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/avfSupportValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/avf_not_supported"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Status"
        android:textColor="@color/warning"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/avfSupportTitle"
        app:layout_constraintBottom_toBottomOf="@id/avfSupportTitle" />

    <!-- VM Configuration Section -->
    <TextView
        android:id="@+id/vmConfigTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vm_config_label"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/avfSupportTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/vmConfigContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/debug_panel"
        app:layout_constraintTop_toBottomOf="@id/vmConfigTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vm_payload"
            android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
            android:textColor="@color/secondary_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vm_memory"
            android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
            android:textColor="@color/secondary_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vm_cpu"
            android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
            android:textColor="@color/secondary_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vm_network"
            android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
            android:textColor="@color/secondary_text" />
    </LinearLayout>

    <!-- Runner Status Section -->
    <TextView
        android:id="@+id/runnerStatusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/runner_status_label"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/vmConfigContainer"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/runnerStatusValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/runner_status_stopped"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Status"
        android:textColor="@color/disabled_text"
        app:layout_constraintTop_toBottomOf="@id/vmConfigContainer"
        app:layout_constraintStart_toEndOf="@id/runnerStatusTitle"
        app:layout_constraintBottom_toBottomOf="@id/runnerStatusTitle" />

    <!-- vsock Status Section -->
    <TextView
        android:id="@+id/vsockStatusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/vsock_status_label"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/runnerStatusTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/vsockStatusValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/vsock_status_disconnected"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Status"
        android:textColor="@color/disabled_text"
        app:layout_constraintTop_toBottomOf="@id/runnerStatusTitle"
        app:layout_constraintStart_toEndOf="@id/vsockStatusTitle"
        app:layout_constraintBottom_toBottomOf="@id/vsockStatusTitle" />

    <!-- Control Buttons -->
    <LinearLayout
        android:id="@+id/controlButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4"
        app:layout_constraintTop_toBottomOf="@id/vsockStatusValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deployRunnerBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_deploy_runner"
            android:icon="@android:drawable/ic_menu_upload"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeRunnerBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_remove_runner"
            android:icon="@android:drawable/ic_menu_delete"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectVsockBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_connect_vsock"
            android:icon="@android:drawable/ic_menu_set_as"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:enabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshStatusBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_refresh_status"
            android:icon="@android:drawable/ic_menu_rotate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/controlButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Activity Log Section -->
    <TextView
        android:id="@+id/logTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/log_label"
        android:textAppearance="@style/TextAppearance.RemoteMedia.Label"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyLogBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/copy_log"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/logTitle" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/surface"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/logTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textAppearance="@style/TextAppearance.RemoteMedia.Transcript"
            android:textColor="@color/primary_text"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            tools:text="[2026-06-10 12:00:00] Microdroid Runner Management Activity started\n[2026-06-10 12:00:01] Checking AVF support...\n[2026-06-10 12:00:01] AVF Support: Supported\n[2026-06-10 12:00:02] Runner Status: Stopped" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>